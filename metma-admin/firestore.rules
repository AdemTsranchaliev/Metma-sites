rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Public read for storefronts later; writes only for logged-in admin users.
    match /products/{id} {
      allow read: if true;
      allow write: if signedIn();
    }
    match /pages/{id} {
      allow read: if true;
      allow write: if signedIn();
    }
    match /blogPosts/{id} {
      allow read: if true;
      allow write: if signedIn();
    }
    match /media/{id} {
      allow read: if true;
      allow write: if signedIn();
    }
    match /categories/{id} {
      allow read: if true;
      allow write: if signedIn();
    }
    match /qrLinks/{id} {
      allow read: if true;
      allow write: if signedIn();
    }
  }
}
